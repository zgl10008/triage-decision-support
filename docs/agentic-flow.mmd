flowchart TD
    A["现场描述 / 图像 / 生命体征"] --> B["输入规范化"]
    B --> C["情况评估<br/>信息是否充分"]
    C -->|"不足"| D["ask_info：追问关键信息"]
    C -->|"充分"| E["自适应检索<br/>dense / TF-IDF / RRF"]
    E --> F["证据评估<br/>相关性 · 覆盖度 · 候选冲突"]
    F -->|"证据不足"| G["改写查询并重检索<br/>受预算约束"]
    G --> E
    F -->|"候选冲突"| H["needs_review：转人工复核"]
    F -->|"证据可用"| I["处置动作规划<br/>动作白名单 + 阶段约束"]
    I --> J["Grounded 生成<br/>输出引用与 source_id"]
    J --> K["确定性校验<br/>禁忌动作 · 无依据动作 · 引用有效"]
    K -->|"可修复"| L["受限修复 / 重规划"]
    L --> J
    K -->|"命中禁忌"| M["blocked：拦截"]
    K -->|"无法验证"| N["reject：拒答"]
    K -->|"通过"| O["return：返回建议与引用"]
    D --> P["结束"]
    H --> P
    M --> P
    N --> P
    O --> P
